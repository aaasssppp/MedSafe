# MedSafe Environment Configuration
# Copy this file to .env and set your Google Gemini API key.

# ==============================================================================
# Google Gemini API Settings
# ==============================================================================
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini LLM models: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
LLM_MODEL=gemini-2.5-flash

# Supported Gemini embedding models: models/gemini-embedding-001, models/text-embedding-004
EMBEDDING_MODEL=models/gemini-embedding-001

# ==============================================================================
# OCR Settings (Optical Character Recognition)
# ==============================================================================
# Optional: Path to tesseract executable if not in system PATH
# Examples:
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: /usr/bin/tesseract
TESSERACT_CMD=

# Minimum characters extracted before OCR fallback triggers (default: 50)
OCR_CHAR_THRESHOLD=50

# ==============================================================================
# Flask Application Settings
# ==============================================================================
FLASK_ENV=development
SECRET_KEY=medsafe-super-secret-key-change-in-production
